# URL del Service Layer del cliente (HANA suele ser puerto 50000)
SAP_SL_URL=https://servidor-sap-cliente:50000/b1s/v1
# Base de datos de empresa en SAP B1
SAP_COMPANY_DB=SBODEMOES
# Usuario de SAP B1 con permisos de compras
SAP_USER=
SAP_PASS=
# Poner a "false" solo si el servidor usa certificado autofirmado (habitual en SAP B1 on-premise)
SAP_VERIFY_SSL=false
